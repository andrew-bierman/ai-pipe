{
  "name": "ai-pipe",
  "version": "1.1.8",
  "description": "A lean CLI for calling LLMs from the terminal. Text in, text out.",
  "keywords": [
    "ai",
    "cli",
    "llm",
    "openai",
    "anthropic",
    "pipe",
    "terminal",
    "openrouter",
    "vercel-ai-sdk",
    "command-line-tool",
    "developer-tools",
    "generative-ai",
    "shell"
  ],
  "homepage": "https://github.com/andrew-bierman/ai-pipe#readme",
  "bugs": {
    "url": "https://github.com/andrew-bierman/ai-pipe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-bierman/ai-pipe.git"
  },
  "license": "GPL-3.0-only",
  "author": "Andrew Bierman",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "ai": "src/index.ts",
    "ai-pipe": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/ai-pipe",
    "build:all": "bun run build:mac && bun run build:mac-x64 && bun run build:linux && bun run build:linux-arm",
    "build:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/ai-pipe-linux-x64",
    "build:linux-arm": "bun build src/index.ts --compile --target=bun-linux-arm64 --outfile dist/ai-pipe-linux-arm64",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/ai-pipe-darwin-arm64",
    "build:mac-x64": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/ai-pipe-darwin-x64",
    "lint": "bunx biome check --write .",
    "lint:check": "bunx biome check .",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.218",
    "@ai-sdk/anthropic": "^3.0.143",
    "@ai-sdk/azure": "^3.0.156",
    "@ai-sdk/cerebras": "^2.0.100",
    "@ai-sdk/cohere": "^3.0.79",
    "@ai-sdk/deepinfra": "^2.0.98",
    "@ai-sdk/deepseek": "^2.0.82",
    "@ai-sdk/fal": "^2.0.74",
    "@ai-sdk/fireworks": "^2.0.104",
    "@ai-sdk/gateway": "^3.0.241",
    "@ai-sdk/google": "^3.0.148",
    "@ai-sdk/google-vertex": "^4.0.235",
    "@ai-sdk/groq": "^3.0.84",
    "@ai-sdk/huggingface": "^1.0.97",
    "@ai-sdk/luma": "^2.0.73",
    "@ai-sdk/mcp": "^1.0.105",
    "@ai-sdk/mistral": "^3.0.82",
    "@ai-sdk/openai": "^3.0.145",
    "@ai-sdk/openai-compatible": "^2.0.94",
    "@ai-sdk/perplexity": "^3.1.13",
    "@ai-sdk/provider": "^3.0.19",
    "@ai-sdk/replicate": "^2.0.73",
    "@ai-sdk/togetherai": "^2.0.101",
    "@ai-sdk/xai": "^3.0.153",
    "@clack/prompts": "^1.9.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.336",
    "ai-sdk-ollama": "^3.8.8",
    "ajv": "^8.20.0",
    "citty": "^0.2.2",
    "remend": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "latest",
    "lefthook": "^2.2.2",
    "sort-package-json": "^3.7.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.0.0"
  }
}
